# CodeAtlas Backend Environment Variables
# Copy this file to .env and fill in your values
# For local development: cp .env.example .env
# For Render: Set these as Environment Variables in the Render dashboard

# ===========================================
# REQUIRED FOR PRODUCTION
# ===========================================

# Comma-separated list of allowed CORS origins
# For local development: http://localhost:5173
# For production: your Vercel frontend URL (e.g., https://codeatlas-frontend.vercel.app)
# Use "*" only for development - NOT recommended for production
ALLOWED_ORIGINS=http://localhost:5173

# Port the server runs on (Render sets this automatically via $PORT)
PORT=8000

# ===========================================
# OPTIONAL: AI FEATURES (Hugging Face)
# ===========================================

# Hugging Face API token for embeddings/LLM features
# Get yours at: https://huggingface.co/settings/tokens
# Required if SKIP_EMBEDDING=false
# Leave empty or remove if not using AI embeddings
HF_TOKEN=

# Set to "true" to disable embedding generation (faster, no HF token needed)
# Set to "false" to enable embeddings (requires HF_TOKEN)
SKIP_EMBEDDING=true

# ===========================================
# OPTIONAL: FUTURE EXTENSIONS
# ===========================================

# Database URL (for future persistence layer)
# DATABASE_URL=postgresql://user:pass@host:port/db

# Redis URL (for future job queue / caching)
# REDIS_URL=redis://localhost:6379/0

# API Keys for external services (future)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=