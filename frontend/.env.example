# CodeAtlas Frontend Environment Variables
# Copy this file to .env.local for local development
# For Vercel: Set these as Environment Variables in the Vercel dashboard

# ===========================================
# REQUIRED
# ===========================================

# Backend API base URL
# Local: http://localhost:8000
# Production: Your Render backend URL (e.g., https://codeatlas-api.onrender.com)
VITE_API_BASE_URL=http://localhost:8000

# ===========================================
# OPTIONAL: FEATURE FLAGS
# ===========================================

# Enable/disable AI chat features (default: true)
# VITE_ENABLE_AI_CHAT=true

# Enable/disable graph visualization (default: true)
# VITE_ENABLE_GRAPH=true

# ===========================================
# OPTIONAL: ANALYTICS / MONITORING
# ===========================================

# Google Analytics Measurement ID (optional)
# VITE_GA_MEASUREMENT_ID=

# Sentry DSN for error tracking (optional)
# VITE_SENTRY_DSN=